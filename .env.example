# Copy to .env (read by `btd serve` / the API) or pass as container environment variables.
BTD_MODEL_PATH=models/model.onnx
# auto | cpu | cuda | tensorrt | comma-separated fallback list, e.g. cuda,cpu
BTD_PROVIDERS=auto
# Override the threshold tuned on validation (leave unset to use model.json)
# BTD_CONF_THRESHOLD=0.35
BTD_MAX_DET=20
BTD_MAX_UPLOAD_MB=10
BTD_MAX_IMAGE_PIXELS=25000000
BTD_MAX_CONCURRENCY=4
# Cap the ONNX Runtime CUDA arena so the service can share a 6 GB GPU
# BTD_GPU_MEM_LIMIT_MB=2048
# Require an API key for /v1/predict*
# BTD_API_KEY=change-me
# JSON list of allowed browser origins for a frontend hosted elsewhere (the built-in page doesn't need it)
# BTD_CORS_ORIGINS=["http://localhost:5173"]
# Serve the web page at / (set to false for API-only deployments)
# BTD_UI=true
BTD_LOG_LEVEL=INFO
BTD_LOG_JSON=false
